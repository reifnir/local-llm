# Copy to .env (git-ignored).
# Hugging Face token: only needed for gated repos. Read-only scope is enough if we aren't uploading to HF.
export HF_TOKEN=""
export TF_VAR_hf_token="$HF_TOKEN"

# Host port for the llama.cpp server (bound to 127.0.0.1 only)
LLM_PORT=8080
# Terraform state. Each project's key is <prefix>/ec2/terraform.tfstate or <prefix>/persistent/terraform.tfstate.
export TERRAFORM_STATE_REGION="us-east-1"
export TERRAFORM_STATE_BUCKET="reifnir-root-terraform-state-primary"
export TERRAFORM_STATE_KEY_PREFIX="reifnir-public-projects/local-llm"
